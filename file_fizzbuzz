from fizzbuzz import fizzbuzz

def procesar_archivo(nombre_archivo="numeros.txt"):
    resultados = []
    with open(nombre_archivo, encoding="utf-8") as archivo:
        for linea in archivo:
            linea = linea.strip()
            if linea == "":
                continue
            resultados.append(fizzbuzz(int(linea)))
    return resultados

print(procesar_archivo())
